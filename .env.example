# WedSnap Environment Variables

# App Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

# Security & Authentication
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET=wedsnap_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials (Created automatically on startup if not present)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin12345

# Face Recognition Settings
FACE_SIMILARITY_THRESHOLD=0.55
FACE_DETECTION_SCORE_THRESHOLD=0.60
FACE_MAX_UPLOAD_SIZE_MB=25

# Storage & Database
# By default, local SQLite + local disk storage is used (100% turnkey zero-config).
DATABASE_URL=sqlite:///./wedsnap.db
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Supabase Integration (Optional - set to use Supabase PostgreSQL & Supabase Storage)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-anon-or-service-role-key
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres
# SUPABASE_STORAGE_BUCKET=wedding-photos
